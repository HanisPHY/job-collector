# Job Collection and Classification System - Environment Variables
# Copy this file to .env and fill in your actual values. .env is gitignored.

# OpenAI API Key - used by enrich_companies.py (company profiles) and by the
# optional LLM company classification in scripts/main.py.
# Get one from: https://platform.openai.com/api-keys
# Without it, enrichment cannot run and every company stays stage 0.
OPENAI_API_KEY=

# LinkedIn API Key (optional, effectively unused).
# LinkedIn's official Jobs API requires partnership access; the collector goes
# through python-jobspy instead. Left here for the code path that checks it.
LINKEDIN_API_KEY=
